{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watchkeeper",
  "version": "0.1.0",
  "identifier": "net.watchkeeper.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "capabilities": [
        "ui",
        "panel"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "msi"
    ],
    "publisher": "Watchkeeper contributors",
    "copyright": "Copyright 2026 Watchkeeper contributors",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "category": "Utility",
    "shortDescription": "A tiny browser that shows you who's watching.",
    "longDescription": "Watchkeeper is a small web browser with a side panel that shows what each site does behind your back: which other sites it tells about your visit, the cookies it leaves, what it writes to your computer and whether it reads the features used to fingerprint your device.",
    "homepage": "https://watchkeeper.net",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
